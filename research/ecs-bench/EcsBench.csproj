<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <Optimize>true</Optimize>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot Condition="'$(AotBuild)' == 'true'">true</PublishAot>
    <NoWarn>$(NoWarn);CS8981;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Expects TinyECS, Friflo.Engine.ECS and Arch cloned as siblings of the classicuo repo. -->
    <ProjectReference Include="..\..\..\TinyECS\src\TinyEcs\TinyEcs.csproj" />
    <ProjectReference Include="..\..\..\Friflo.Engine.ECS\src\ECS\Friflo.Engine.ECS.csproj" />
    <ProjectReference Include="..\..\..\Arch\src\Arch\Arch.csproj" />
    <PackageReference Include="Flecs.NET.Release" Version="4.0.3" />
  </ItemGroup>
</Project>
