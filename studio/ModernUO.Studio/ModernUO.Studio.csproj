<Project Sdk="Microsoft.NET.Sdk">

  <!-- ModernUO Studio: the asset and map tooling exe. It references the client's libraries (ClassicUO.Assets for the pack,
       ClassicUO.Renderer for the atlases and the batcher) and never the game client, so it can move to its own repo. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>Preview</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>muostudio</AssemblyName>
    <RootNamespace>ModernUO.Studio</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- the ModernUO logo (modernuo.com/branding), as the exe and taskbar icon -->
    <ApplicationIcon>Branding\muostudio.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>$(ProjectDir)..\..\bin\Studio\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>$(ProjectDir)..\..\bin\Studio\Debug\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
  </ItemGroup>

  <!-- Inter 4.1 and JetBrains Mono 2.304 (SIL OFL 1.1), Lucide 1.67.0 (ISC): embedded so Studio looks the same everywhere.
       Licences are next to the fonts in Fonts/. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="%(Filename)%(Extension)" />
    <!-- the logo pre-rendered (bicubic) at the sizes it is drawn at: a GPU-scaled 512 px image looks choppy at 20 px -->
    <EmbeddedResource Include="Branding\logo-*.png" Exclude="Branding\logo-512.png" LogicalName="%(Filename)%(Extension)" />
    <None Include="Fonts\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" />
    <ProjectReference Include="..\..\src\ClassicUO.Assets\ClassicUO.Assets.csproj" />
    <ProjectReference Include="..\..\src\ClassicUO.Renderer\ClassicUO.Renderer.csproj" />
    <ProjectReference Include="..\..\src\ClassicUO.Utility\ClassicUO.Utility.csproj" />
    <ProjectReference Include="..\..\poc\Uo.Render\Uo.Render.csproj" />
  </ItemGroup>

  <!-- Uo.Render binds SDL3 through SDL3-CS's SDL3.Core assembly while FNA compiles SDL3.Legacy.cs into FNA.dll; both
       declare SDL3.SDL. SDL3.Core gets an extern alias (sdl3core) so plain SDL3.SDL keeps meaning FNA's (as in the client). -->
  <Target Name="AliasSdl3Core" AfterTargets="FindReferenceAssembliesForReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Condition="'%(Filename)' == 'SDL3.Core'">
        <Aliases>sdl3core</Aliases>
      </ReferencePathWithRefAssemblies>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <DataFiles_x64 Include="$(ProjectDir)..\..\external\x64\*.*" />
    <DataFiles_lib64 Include="$(ProjectDir)..\..\external\lib64\*.*" />
    <DataFiles_osx Include="$(ProjectDir)..\..\external\osx\*.*" />
  </ItemGroup>

  <Target Name="CopyExternalDeps_build" AfterTargets="Build">
    <Copy SourceFiles="@(DataFiles_x64)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Copy SourceFiles="@(DataFiles_lib64)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </Target>

</Project>
