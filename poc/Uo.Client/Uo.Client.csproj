<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(PublishAot)' != 'true'">false</SelfContained>
    <!-- NativeAOT: dotnet publish -c Release -p:PublishAot=true (vswhere.exe on PATH) -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uo.Render\Uo.Render.csproj" />
    <ProjectReference Include="..\Uo.Net\Uo.Net.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\external\x64\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
