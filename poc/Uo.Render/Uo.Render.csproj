<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- Class library: the renderer, streaming and pack tables. Uo.Render.App (benches, screenshots) and Uo.Client are the exes. -->
    <Dxc Condition="'$(Dxc)' == ''">C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\dxc.exe</Dxc>
    <!-- SPIR-V needs an official DXC release (the SDK dxc has no SPIR-V backend); kept outside the repo. Without it the
         build skips SPIR-V and only the D3D12 driver is available. -->
    <DxcSpirv Condition="'$(DxcSpirv)' == ''">C:\Repositories\tools\dxc\v1.9.2609\bin\x64\dxc.exe</DxcSpirv>
    <ShaderOut>$(MSBuildProjectDirectory)\obj\shaders\</ShaderOut>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uo.Pack\Uo.Pack.csproj" />
    <ProjectReference Include="..\..\external\FNA\lib\SDL3-CS\SDL3\SDL3.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <HlslSource Include="Shaders\*.hlsl" />
  </ItemGroup>

  <!-- HLSL -> DXIL at build time with the Windows SDK dxc. The DXIL is embedded as a resource
       (works for NativeAOT publish too). SDL_GPU register conventions are documented in sprite.hlsl. -->
  <Target Name="CompileShaders" BeforeTargets="BeforeBuild" Inputs="@(HlslSource)" Outputs="$(ShaderOut)sprite.vs.dxil;$(ShaderOut)sprite.ps.dxil;$(ShaderOut)sprite.vsgeo.dxil;$(ShaderOut)sprite.psgeo.dxil">
    <MakeDir Directories="$(ShaderOut)" />
    <Exec Command="&quot;$(Dxc)&quot; -nologo -T vs_6_0 -E VSMain -O3 -Fo &quot;$(ShaderOut)sprite.vs.dxil&quot; &quot;Shaders\sprite.hlsl&quot;" />
    <Exec Command="&quot;$(Dxc)&quot; -nologo -T ps_6_0 -E PSMain -O3 -Fo &quot;$(ShaderOut)sprite.ps.dxil&quot; &quot;Shaders\sprite.hlsl&quot;" />
    <Exec Command="&quot;$(Dxc)&quot; -nologo -T vs_6_0 -E VSMain -D GEO=1 -O3 -Fo &quot;$(ShaderOut)sprite.vsgeo.dxil&quot; &quot;Shaders\sprite.hlsl&quot;" />
    <Exec Command="&quot;$(Dxc)&quot; -nologo -T ps_6_0 -E PSMainGeo -D GEO=1 -O3 -Fo &quot;$(ShaderOut)sprite.psgeo.dxil&quot; &quot;Shaders\sprite.hlsl&quot;" />
  </Target>

  <!-- HLSL -> SPIR-V (Vulkan) with the same source; SDL_GPU's SPIR-V set/binding conventions are in sprite.hlsl. -->
  <Target Name="CompileShadersSpirv" BeforeTargets="BeforeBuild" Condition="Exists('$(DxcSpirv)')" Inputs="@(HlslSource)" Outputs="$(ShaderOut)sprite.vs.spv;$(ShaderOut)sprite.ps.spv;$(ShaderOut)sprite.vsgeo.spv;$(ShaderOut)sprite.psgeo.spv">
    <MakeDir Directories="$(ShaderOut)" />
    <Exec Command="&quot;$(DxcSpirv)&quot; -nologo -spirv -fspv-target-env=vulkan1.0 -fvk-use-dx-layout -T vs_6_0 -E VSMain -O3 -Fo &quot;$(ShaderOut)sprite.vs.spv&quot; &quot;Shaders\sprite.hlsl&quot;" />
    <Exec Command="&quot;$(DxcSpirv)&quot; -nologo -spirv -fspv-target-env=vulkan1.0 -fvk-use-dx-layout -T ps_6_0 -E PSMain -O3 -Fo &quot;$(ShaderOut)sprite.ps.spv&quot; &quot;Shaders\sprite.hlsl&quot;" />
    <Exec Command="&quot;$(DxcSpirv)&quot; -nologo -spirv -fspv-target-env=vulkan1.0 -fvk-use-dx-layout -T vs_6_0 -E VSMain -D GEO=1 -O3 -Fo &quot;$(ShaderOut)sprite.vsgeo.spv&quot; &quot;Shaders\sprite.hlsl&quot;" />
    <Exec Command="&quot;$(DxcSpirv)&quot; -nologo -spirv -fspv-target-env=vulkan1.0 -fvk-use-dx-layout -T ps_6_0 -E PSMainGeo -D GEO=1 -O3 -Fo &quot;$(ShaderOut)sprite.psgeo.spv&quot; &quot;Shaders\sprite.hlsl&quot;" />
  </Target>

  <Target Name="EmbedShaders" AfterTargets="CompileShaders;CompileShadersSpirv" BeforeTargets="BeforeBuild">
    <Warning Condition="!Exists('$(DxcSpirv)')" Text="DXC with SPIR-V not found at $(DxcSpirv): building without Vulkan shaders" />
    <ItemGroup>
      <EmbeddedResource Include="$(ShaderOut)sprite.vs.dxil" LogicalName="sprite_vs.dxil" WithCulture="false" />
      <EmbeddedResource Include="$(ShaderOut)sprite.ps.dxil" LogicalName="sprite_ps.dxil" WithCulture="false" />
      <EmbeddedResource Include="$(ShaderOut)sprite.vsgeo.dxil" LogicalName="sprite_vsgeo.dxil" WithCulture="false" />
      <EmbeddedResource Include="$(ShaderOut)sprite.psgeo.dxil" LogicalName="sprite_psgeo.dxil" WithCulture="false" />
      <EmbeddedResource Include="$(ShaderOut)sprite.vs.spv" LogicalName="sprite_vs.spv" WithCulture="false" Condition="Exists('$(DxcSpirv)')" />
      <EmbeddedResource Include="$(ShaderOut)sprite.ps.spv" LogicalName="sprite_ps.spv" WithCulture="false" Condition="Exists('$(DxcSpirv)')" />
      <EmbeddedResource Include="$(ShaderOut)sprite.vsgeo.spv" LogicalName="sprite_vsgeo.spv" WithCulture="false" Condition="Exists('$(DxcSpirv)')" />
      <EmbeddedResource Include="$(ShaderOut)sprite.psgeo.spv" LogicalName="sprite_psgeo.spv" WithCulture="false" Condition="Exists('$(DxcSpirv)')" />
    </ItemGroup>
  </Target>

</Project>
