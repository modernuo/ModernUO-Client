<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <DebugType>Full</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net11.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <!-- T1 round 4: syntax trees for the write-site scanner's structural checks (fallback guards, the walk queue) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="16.6.1" Condition="$(TargetFramework.StartsWith('net4')) AND '$(OS)' == 'Unix'" />
  </ItemGroup>

  <!-- Synthetic MP3 fixtures (no UO data): the loop-seam noise file and the fuzz regressions. -->
  <ItemGroup>
    <None Include="IO/Fixtures/seam-noise.mp3;IO/Fixtures/mp3-regressions/*.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- FNA3D (and the SDL3 it links) for the world map PNG decode tests, which call FNA3D's stb_image reader. -->
  <ItemGroup>
    <None Include="..\..\external\x64\FNA3D.dll;..\..\external\x64\SDL3.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\external\lib64\libFNA3D.so.0;..\..\external\lib64\libSDL3.so.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\external\osx\libFNA3D.0.dylib;..\..\external\osx\libSDL3.0.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Utility/zlib-vectors.txt" Link="zlib-vectors.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The converter's audio importer (it depends only on ClassicUO.IO and Uo.Pack), run on synthetic MUL files. -->
  <ItemGroup>
    <Compile Include="..\..\tools\Uo.Converter\AudioImport.cs" Link="Assets\AudioImport.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassicUO.Client\ClassicUO.Client.csproj" />
    <!-- The converter's frozen pre-pack loaders, under an extern alias (their types share the client's names): the audio
         tests run verify's model of the client's sound resolution on the real frozen SoundsLoader. -->
    <ProjectReference Include="..\..\tools\ClassicUO.Assets.Mul\ClassicUO.Assets.Mul.csproj" Aliases="frozen" />
    <!-- The MUL readers (UOFile and friends) that the linked tools/Uo.Converter/AudioImport.cs uses; the client has none,
         so no alias is needed. -->
    <ProjectReference Include="..\..\tools\ClassicUO.IO.Mul\ClassicUO.IO.Mul.csproj" />
  </ItemGroup>

  <!-- Separate processes discard the outer build's solution mappings and evaluate freshly after restore. -->
  <Target Name="PrepareReleaseDiagnosticsGuard" AfterTargets="Build">
    <PropertyGroup>
      <_GuardRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</_GuardRoot>
      <_GuardProperties>-p:CuoDevTools=false -p:DirectoryBuildPropsPath=&quot;$(_GuardRoot)build/ReleaseDiagnosticsGuard.props&quot; -p:CustomAfterMicrosoftCommonTargets=&quot;$(_GuardRoot)build/ReleaseDiagnosticsGuard.targets&quot; -p:ReleaseDiagnosticsGuardDir=&quot;$(TargetDir)release-guard&quot;</_GuardProperties>
    </PropertyGroup>
    <Exec Command="dotnet restore -p:Configuration=Release &quot;$(_GuardRoot)src/ClassicUO.Client/ClassicUO.Client.csproj&quot; $(_GuardProperties)" />
    <Exec Command="dotnet build &quot;$(_GuardRoot)src/ClassicUO.Client/ClassicUO.Client.csproj&quot; -c Release --no-restore $(_GuardProperties)" />
  </Target>
</Project>
