+FNA3DAPI void* FNA3D_SDLGPU_GetTextureEXT(
+	FNA3D_Device *device,
+	FNA3D_Texture *texture
+) {
+	if (	device == NULL ||
+		texture == NULL ||
+		device->GetSysRenderer != SDLGPU_GetSysRenderer	)
+	{
+		return NULL;
+	}
+	return ((SDLGPU_TextureHandle*) texture)->texture;
+}
